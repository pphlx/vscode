{
  "name": "PPHLX",
  "scopeName": "text.html.pphx",
  "injections": {
    "L:entity.name.tag.html, L:entity.name.tag": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_.]*)\\b",
          "name": "entity.name.type.class.component.pphx support.class.component.pphx"
        }
      ]
    },
    "text.html.pphx - (meta.embedded | meta.tag), L:((text.html.pphx meta.tag) - (meta.embedded.block.php | meta.embedded.line.php)), L:(source.js - (meta.embedded.block.php | meta.embedded.line.php)), L:(source.css - (meta.embedded.block.php | meta.embedded.line.php))": {
      "patterns": [
        {
          "include": "#php-tag"
        }
      ]
    }
  },
  "patterns": [
    {
      "include": "#import-directive"
    },
    {
      "include": "#island-directive"
    },
    {
      "include": "#component-tag"
    },
    {
      "include": "#slot-placeholder"
    },
    {
      "include": "#php-tag"
    },
    {
      "begin": "\\A#!",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.php"
        }
      },
      "end": "$",
      "name": "comment.line.shebang.php"
    },
    {
      "include": "text.html.derivative"
    }
  ],
  "repository": {
    "import-directive": {
      "patterns": [
        {
          "match": "(?m)^\\s*(@import)\\b(?:\\s+([A-Za-z0-9_]+))?(?:\\s+(from))?(?:\\s+(['\"])([^'\"]*)(['\"]))?",
          "captures": {
            "1": { "name": "keyword.control.import.pphx" },
            "2": { "name": "entity.name.type.class.component.pphx support.class.component.pphx" },
            "3": { "name": "keyword.control.from.pphx" },
            "4": { "name": "string.quoted.pphx" },
            "5": { "name": "string.quoted.path.pphx" },
            "6": { "name": "string.quoted.pphx" }
          }
        }
      ]
    },
    "island-directive": {
      "patterns": [
        {
          "match": "\\b(client:(?:load|visible|idle|only))\\b",
          "name": "keyword.control.directive.pphx entity.other.attribute-name.directive.pphx"
        }
      ]
    },
    "slot-placeholder": {
      "patterns": [
        {
          "match": "\\{\\{\\s*slot\\s*\\}\\}",
          "name": "keyword.other.slot.pphx entity.name.variable.slot.pphx"
        }
      ]
    },
    "component-tag": {
      "patterns": [
        {
          "begin": "(</?)([A-Z][A-Za-z0-9_.]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.pphx" },
            "2": { "name": "entity.name.type.class.component.pphx support.class.component.pphx" }
          },
          "end": "(/?>(?!>))",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.pphx" }
          },
          "name": "meta.tag.component.pphx",
          "patterns": [
            {
              "include": "#island-directive"
            },
            {
              "include": "#php-tag"
            },
            {
              "include": "text.html.basic#attribute"
            }
          ]
        }
      ]
    },
    "php-tag": {
      "patterns": [
        {
          "begin": "\\{\\|(=)?",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.php"
            }
          },
          "end": "\\|\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.php"
            }
          },
          "name": "meta.embedded.block.php",
          "contentName": "source.php",
          "patterns": [
            {
              "include": "source.php"
            }
          ]
        },
        {
          "begin": "\\{(=)?(?=\\s*\\$)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.php"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.php"
            }
          },
          "name": "meta.embedded.expression.pphx",
          "contentName": "source.php",
          "patterns": [
            {
              "include": "source.php"
            }
          ]
        },
        {
          "begin": "<\\?(?i:php|=)?(?![^?]*\\?>)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.php"
            }
          },
          "end": "(\\?)>",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.php"
            },
            "1": {
              "name": "source.php"
            }
          },
          "name": "meta.embedded.block.php",
          "contentName": "source.php",
          "patterns": [
            {
              "include": "source.php"
            }
          ]
        },
        {
          "begin": "<\\?(?i:php|=)?",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.php"
            }
          },
          "end": "(\\?)>",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.php"
            },
            "1": {
              "name": "source.php"
            }
          },
          "name": "meta.embedded.line.php",
          "contentName": "source.php",
          "patterns": [
            {
              "include": "source.php"
            }
          ]
        }
      ]
    }
  }
}